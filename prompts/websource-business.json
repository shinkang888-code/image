        "light": ["soft diffuse light", "gentle raking light revealing texture"]
      }
    },
    "icon_scene": {
      "_w": 3,
      "template": "a minimal 3d illustration of {object}, {style}, {palette}, centered on plain background",
      "axes": {
        "object": ["a shopping bag", "a location pin", "a calendar", "a chat bubble", "a shield badge", "a growth chart"],
        "style": ["soft clay render", "glossy plastic render"],
        "palette": ["pastel neutral", "brand blue and white"]
